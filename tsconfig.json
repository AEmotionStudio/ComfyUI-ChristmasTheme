{
    "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2023",
            "DOM",
            "DOM.Iterable"
        ],
        "strict": true,
        "strictNullChecks": false,
        "noImplicitAny": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "sourceMap": true,
        "noEmit": true,
        "allowJs": true,
        "baseUrl": ".",
        "typeRoots": [
            "./src/types",
            "./node_modules/@types"
        ],
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts",
        "vite.config.mts"
    ],
    "exclude": [
        "node_modules",
        "js"
    ]
}